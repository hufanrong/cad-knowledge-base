# CAD Knowledge Base - Environment Configuration
# Copy this file to .env and fill in your values

# === Database ===
# SQLite database file path (relative to project root or absolute)
CADKB_DB_PATH=KnowledgeBase/database/cadkb.db

# === ODA File Converter ===
# Path to ODAFileConverter.exe (leave empty to auto-detect)
# Default Windows: C:\Program Files\ODA\ODAFileConverter\ODAFileConverter.exe
CADKB_ODA_PATH=

# === Knowledge Base Root ===
# Root directory for storing CAD files and data
CADKB_KB_ROOT=KnowledgeBase

# === LLM (AI 问答，可选) ===
# 未配置时 AI 问答会进入「证据模式」，只返回检索结果，不生成自然语言回答。
#
# 方式 1：本地部署（数据完全不出本机，推荐安全要求高的场景）
# 先安装 Ollama，运行：ollama pull llama3.1
# CADKB_LLM_BASE_URL=http://localhost:11434/v1
# CADKB_LLM_API_KEY=ollama
# CADKB_LLM_MODEL=llama3.1
#
# 方式 2：国内 OpenAI 兼容 API（问题/上下文会发送到服务商）
# DeepSeek:  https://platform.deepseek.com
# 智谱 GLM: https://open.bigmodel.cn
# 通义千问: https://dashscope.aliyun.com
# 火山方舟: https://console.volcengine.com/ark
#
# 示例（DeepSeek）：
# CADKB_LLM_BASE_URL=https://api.deepseek.com/v1
# CADKB_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CADKB_LLM_MODEL=deepseek-chat
#
# 示例（智谱 GLM-4）：
# CADKB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# CADKB_LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxx
# CADKB_LLM_MODEL=glm-4

# === Embedding (Phase 6+, optional) ===
# CADKB_EMBEDDING_MODEL=BAAI/bge-m3

# === Logging ===
CADKB_LOG_LEVEL=INFO
CADKB_LOG_DIR=KnowledgeBase/logs
